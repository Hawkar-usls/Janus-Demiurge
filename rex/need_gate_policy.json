{
  "schema": "janus.nexus.rex_need_gate_policy.v1",
  "version": "1.1",
  "enabled": true,
  "allowed_need_kinds": [
    "ACCUMULATING_JSON_LEDGER"
  ],
  "allowed_templates": [
    "ledger_summary"
  ],
  "allowed_observed_roots": [
    "rex/lifecycle_runs",
    "rex/runs"
  ],
  "requirements": {
    "min_evidence_records": 3,
    "max_auto_approvals_per_run": 1,
    "proposal_authority_delta": 0,
    "desire_authority_delta": 0,
    "request_autorun": true,
    "lifecycle_mode": "SCHEDULED",
    "scheduled_interval_minutes": 360,
    "proposal_state": "PROPOSED_ONLY__NEXUS_NEED_GATE_REQUIRED",
    "refuse_observed_family_suffixes": [
      "_ledger_summary"
    ]
  },
  "firewall": [
    "PROPOSAL_NE_DESIRE",
    "NEED_GATE_APPROVAL_NE_CODE_ADMISSION",
    "NEED_GATE_APPROVAL_NE_LIFECYCLE_ADMISSION",
    "DIRECTOR_STILL_REQUIRED",
    "AUDITOR_STILL_REQUIRED",
    "NEXUS_EXACT_SHA_CODE_ADMISSION_STILL_REQUIRED",
    "SUMMARY_OF_SUMMARY_RECURSION_FORBIDDEN",
    "NO_NETWORK_NO_SECRETS_BY_DEFAULT",
    "AUTHORITY_DELTA_ZERO"
  ]
}
