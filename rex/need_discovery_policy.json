{
  "schema": "janus.rex.need_discovery_policy.v1",
  "version": "1.0",
  "enabled": true,
  "observation": {
    "ledger_roots": [
      "rex/lifecycle_runs",
      "rex/runs"
    ],
    "min_records_per_family": 3,
    "max_evidence_refs": 8,
    "max_proposals_per_run": 4,
    "require_authority_delta_zero_when_present": true
  },
  "proposal": {
    "need_kind": "ACCUMULATING_JSON_LEDGER",
    "template": "ledger_summary",
    "module_suffix": "_ledger_summary",
    "request_autorun": true,
    "lifecycle_mode": "SCHEDULED",
    "interval_minutes": 360,
    "max_birth_rows": 8
  },
  "firewall": [
    "OBSERVATION_IS_NOT_DESIRE",
    "DESIRE_PROPOSAL_IS_NOT_ADMISSION",
    "NEED_DISCOVERY_MUST_NOT_WRITE_SOURCE_CODE",
    "NEED_DISCOVERY_MUST_NOT_GRANT_LIFECYCLE",
    "NEXUS_NEED_GATE_REQUIRED",
    "AUTHORITY_DELTA_ZERO"
  ]
}
