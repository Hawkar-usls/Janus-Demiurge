{
  "schema": "janus.demiurge.activator_credentialless_mailbox.v1.0",
  "status": "DISPATCH_ACK_ONLY_UNTIL_IDENTITY_GATE",
  "purpose": "Provide a second cross-repository Activator transport that never exports a GitHub credential from its owning repository.",
  "repositories": {
    "home": "Hawkar-usls/Hawkar-usls",
    "target": "Hawkar-usls/Janus-Demiurge"
  },
  "branches": {
    "home_mailbox": "janus/transport-mailbox",
    "target_mailbox": "janus/activator-mailbox"
  },
  "paths": {
    "home_outbox": ".janus/mailbox/outbox",
    "target_inbox": ".janus/mailbox/inbox"
  },
  "accepted_message_kinds_v1_0": [
    "DISPATCH_PACKET"
  ],
  "blocked_message_kinds_v1_0": [
    "EXECUTION_GRANT"
  ],
  "response_kinds_v1_0": [
    "DELIVERY_ACK"
  ],
  "transport_law": [
    "OWN_REPOSITORY_WRITE_USES_ONLY_LOCAL_GITHUB_TOKEN",
    "CROSS_REPOSITORY_BOUNDARY_IS_PUBLIC_READ_ONLY",
    "MESSAGE_PATH_IS_APPEND_ONLY_BY_DETERMINISTIC_ID",
    "DELIVERY_ACK_IS_NOT_EXECUTION_AUTHORITY",
    "PUBLIC_HASH_BOUND_MESSAGE != P12_EXECUTION_AUTHORITY",
    "EXECUTION_GRANT_REQUIRES_AUTHENTICATED_SOURCE_IDENTITY_BEFORE_CLAIM",
    "SILENCE_IS_NOT_NEGATIVE_EVIDENCE",
    "PULL_MAILBOX_DOES_NOT_REPLACE_SECRET_PUSH_TRANSPORT"
  ],
  "execution_firewall": {
    "credentialless_v1_0_execution_enabled": false,
    "execution_claim_allowed_before_identity_verification": false,
    "execution_response_path_must_not_be_consumed_by_unauthenticated_grant": true,
    "next_gate": "BIDIRECTIONAL_GITHUB_ACTIONS_OIDC_OBJECT_BOUND_IDENTITY"
  },
  "authority_ceiling": {
    "command_authority_granted": false,
    "claim_authority_granted": false,
    "scientific_evidence_authority_granted": false,
    "external_effect_authorized": false,
    "physical_runtime_effect_authorized": false,
    "repository_write_authorized_by_cross_repo_message": false
  },
  "provenance": {
    "v1_0_class": "PUBLIC_REPOSITORY_ORIGIN_PLUS_HASH_BOUND_OBJECT",
    "identity_proof": false,
    "strict_launch_equivalence_to_pinned_actions_provenance": false,
    "next_hardening": "OIDC_SIGNED_MAILBOX_ENVELOPE"
  },
  "polling": {
    "default_schedule": "*/5 * * * *",
    "missing_mailbox": "NOOP_NOT_NEGATIVE_EVIDENCE",
    "existing_response": "IDEMPOTENT_SKIP"
  }
}
