{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "janus.demiurge.activator_execution_receipt.v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "execution_id", "created_at", "source_actor", "source_actor_trust_model",
    "grant_id", "grant_hash", "target_repository", "target_head_sha", "operation", "risk_class",
    "execution_scope", "execution_authorized", "execution_performed", "snapshot_hash",
    "target_process_network_access", "model_access", "repository_write_performed",
    "command_authority_granted", "claim_authority_granted", "scientific_evidence_authority_granted",
    "external_effect_authorized", "external_effect_performed", "physical_runtime_effect_authorized",
    "terminal", "reasons", "receipt_hash"
  ],
  "properties": {
    "schema": {"const": "janus.demiurge.activator_execution_receipt.v0.1"},
    "execution_id": {"type": "string", "pattern": "^exec-[0-9a-f]{64}$"},
    "created_at": {"type": "number", "minimum": 0},
    "source_actor": {"type": "string"},
    "source_actor_trust_model": {"type": "string"},
    "grant_id": {"type": "string", "pattern": "^xg-[0-9a-f]{64}$"},
    "grant_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "target_repository": {"const": "Hawkar-usls/Janus-Demiurge"},
    "target_head_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "operation": {"const": "READ_ONLY_ORIENTATION_SNAPSHOT"},
    "risk_class": {"const": "R0_INTERNAL_READ_ONLY_ORIENTATION"},
    "execution_scope": {"const": "TARGET_REPOSITORY_LOCAL_READ_ONLY_METADATA"},
    "execution_authorized": {"type": "boolean"},
    "execution_performed": {"type": "boolean"},
    "snapshot_hash": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "target_process_network_access": {"const": false},
    "model_access": {"const": false},
    "repository_write_performed": {"const": false},
    "command_authority_granted": {"const": false},
    "claim_authority_granted": {"const": false},
    "scientific_evidence_authority_granted": {"const": false},
    "external_effect_authorized": {"const": false},
    "external_effect_performed": {"const": false},
    "physical_runtime_effect_authorized": {"const": false},
    "terminal": {"enum": ["EXECUTED_READ_ONLY_ORIENTATION", "EXECUTION_BLOCKED_UNTRUSTED_GITHUB_ACTOR", "EXECUTION_BLOCKED_INVALID_GRANT"]},
    "reasons": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "receipt_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "allOf": [
    {
      "if": {"properties": {"terminal": {"const": "EXECUTED_READ_ONLY_ORIENTATION"}}},
      "then": {
        "properties": {
          "execution_authorized": {"const": true},
          "execution_performed": {"const": true},
          "snapshot_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      },
      "else": {
        "properties": {
          "execution_authorized": {"const": false},
          "execution_performed": {"const": false},
          "snapshot_hash": {"const": null}
        }
      }
    }
  ]
}
