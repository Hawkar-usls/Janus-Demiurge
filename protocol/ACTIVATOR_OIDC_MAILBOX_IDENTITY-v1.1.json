    "world_truth_authority_granted": false,
    "external_effect_authorized": false,
    "physical_runtime_effect_authorized": false,
    "target_execution_authorized": false,
    "target_execution_performed": false
  },
  "laws": [
    "OIDC_IDENTITY != COMMAND_AUTHORITY",
    "OIDC_IDENTITY != SCIENTIFIC_TRUTH",
    "OIDC_PACKET_ACK != P12_EXECUTION_GRANT",
    "PUBLIC_HASH_BOUND_MESSAGE_WITHOUT_VALID_OIDC != AUTHENTICATED_SOURCE",
    "SOURCE_OIDC_VERIFIED + TARGET_UNSIGNED_RESPONSE != BIDIRECTIONAL_IDENTITY",
    "AUDIENCE_MISMATCH == IDENTITY_REJECT",
    "REPOSITORY_ID_MISMATCH == IDENTITY_REJECT",
    "WORKFLOW_REF_MISMATCH == IDENTITY_REJECT",
    "REF_MISMATCH == IDENTITY_REJECT",
    "BOUND_AT_OUTSIDE_TOKEN_WINDOW == IDENTITY_REJECT",
    "SILENCE != NEGATIVE_EVIDENCE"
  ]
}
