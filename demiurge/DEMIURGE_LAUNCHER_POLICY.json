{
  "schema": "janus.demiurge.full_launcher_policy.v1",
  "version": "1.0",
  "mode": "FULL_DEMIURGE_WAKE",
  "workflow_directory": ".github/workflows",
  "self_workflow": "janus-demiurge-full-launcher.yml",
  "dispatch_ref": "main",
  "max_dispatches": 96,
  "dispatch_delay_seconds": 1.0,
  "strict_dispatch": true,
  "inject_target_sha_when_declared": true,
  "priority": [
    "janus-native-intensive-wake.yml",
    "janus-native-model.yml",
    "janus-research-spine.yml",
    "janus-systemwide-scout-directions.yml",
    "janus-demiurge-scout-swarm.yml",
    "janus-topa-scout-epistemic.yml",
    "janus-beetle-director.yml",
    "janus-outcome-learning.yml",
    "janus-soul-hindsight.yml",
    "janus-rex-need-discovery.yml",
    "janus-rex-director.yml",
    "janus-rex-organogenesis.yml",
    "janus-rex-lifecycle.yml"
  ],
  "workflow_inputs": {
    "janus-native-model.yml": {
      "mode": "run",
      "prompt": "JANUS Full Demiurge Launcher: report current state and participate in the coordinated full-system wake."
    },
    "janus-rex-lifecycle.yml": {
      "trigger_mode": "schedule"
    }
  },
  "authority": {
    "launcher_is_admission": false,
    "launcher_grants_code_admission": false,
    "launcher_grants_lifecycle": false,
    "launcher_grants_evidence_status": false,
    "launcher_bypasses_nexus": false,
    "launcher_bypasses_auditor": false,
    "authority_delta": 0
  },
  "firewall": [
    "WAKE_NE_ADMISSION",
    "DISPATCH_NE_EVIDENCE",
    "DISPATCH_NE_SUCCESS",
    "EVERY_SUBSYSTEM_RETAINS_OWN_GATES",
    "PASSIVE_WORKFLOWS_MUST_NOT_RECEIVE_FABRICATED_EVENTS",
    "LAUNCHER_MUST_NOT_DISPATCH_ITSELF",
    "AUTHORITY_DELTA_ZERO"
  ],
  "law": "LAUNCHER_MAY_WAKE_NE_LAUNCHER_MAY_CROWN"
}
