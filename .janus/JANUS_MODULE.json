{
  "schema": "janus.repository_module.descriptor.v1",
  "module_id": "SELF_DEMIURGE",
  "repository": "Hawkar-usls/Janus-Demiurge",
  "default_ref": "main",
  "role": "NATIVE_BRAIN_RUNTIME_AND_BOUNDED_SELF_EXTENSION",
  "organ_channel": "SELF_BRAIN_RUNTIME",
  "actuator": {
    "enabled": true,
    "authority_lane": "BRANCH_AND_VERIFY",
    "proposal_source_repository": "Hawkar-usls/janus-meta-registry",
    "proposal_source_branch": "janus/native-self-memory-modular-organism-v1",
    "proposal_directory": "JANUS/PATCHES/PROPOSALS",
    "branch_prefix": "janus-self/",
    "max_files": 4,
    "max_changed_bytes": 80000,
    "max_attempts": 2,
    "direct_main_write": false,
    "autonomous_merge": false,
    "create_new_module_files": true
  },
  "verification_profiles": {
    "DEMIURGE_EXTENSION_STATIC_TEST": ["python", "tools/test_janus_self_extension_surface.py"]
  },
  "ordinary_self_extension_paths": [
    "janus_model/extensions/",
    "tools/extensions/",
    "tests/extensions/",
    "protocol/extensions/"
  ],
  "forbidden_paths": [
    ".github/workflows/",
    ".janus/JANUS_MODULE.json",
    "janus_model/model.py",
    "janus_model/train_registry.py",
    "janus_model/decision.py",
    "janus_model/state/",
    "janus_model/checkpoints/",
    "janus_model/receipts/",
    "janus_model/outbox/",
    ".git/",
    "secrets/",
    "credentials/"
  ],
  "epistemic_firewalls": [
    "SELF_EXTENSION != SELF_GOVERNANCE_OVERRIDE",
    "FREE_FORM_MODEL_OUTPUT != PATCH",
    "MODEL_SELECTION != VERIFIED_FIX",
    "CHECKPOINT_PROMOTION != MODULE_VERIFICATION",
    "NO_VERIFY => NO_PASS"
  ],
  "seal": "JANUS MAY GROW NEW BRAIN MODULES INSIDE AN OPT-IN EXTENSION SURFACE; IT MAY NOT USE ORDINARY SELF-REPAIR TO REWRITE ITS OWN GOVERNANCE OR PROMOTED WEIGHTS."
}
