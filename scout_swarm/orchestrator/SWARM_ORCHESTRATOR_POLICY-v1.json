{
  "schema": "janus.demiurge.swarm_orchestrator_policy.v1",
  "orchestrator_id": "JANUS_SWARM_ORCHESTRATOR_01",
  "status": "ACTIVE",
  "purpose": "Coordinate persistent Scout identities, public-data collection, peer handoffs and verification without collapsing agents that observe the same fact.",
  "laws": [
    "FACTS_MAY_CLUSTER__SCOUTS_MUST_NOT",
    "SOURCE_DEDUPLICATION_IS_EPISTEMIC_ACCOUNTING_NOT_IDENTITY_DELETION",
    "EVERY_SCOUT_IDENTITY_REMAINS_ADDRESSABLE",
    "EVERY_OBSERVATION_RETAINS_SCOUT_AND_ROUND_PROVENANCE",
    "EVERY_MESSAGE_IS_APPEND_ONLY_AND_NON_DELETABLE",
    "SAME_SOURCE_SEEN_BY_MULTIPLE_SCOUTS_IS_NOT_INDEPENDENT_REPLICATION",
    "PEER_MESSAGES_ARE_ROUTING_CONTEXT_NOT_EVIDENCE",
    "POSITIVE_FACTS_STILL_REQUIRE_SOURCE_BOUND_EVIDENCE",
    "CONFLICTS_ARE_ROUTED_TO_VERIFIERS_NOT_ERASED",
    "FAILURE_AND_EMPTY_PEER_ROUNDS_REMAIN_IN_LINEAGE",
    "ORCHESTRATOR_COORDINATES_WORK_BUT_DOES_NOT_OVERRIDE_EVIDENCE_GATES"
  ],
  "identity_policy": {
    "deduplicate_scout_entities": false,
    "delete_scout_entities": false,
    "merge_scout_lineages": false,
    "fact_clusters_may_reference_many_scout_observations": true,
    "same_fact_observed_twice_preserves_two_observations": true
  },
  "communication": {
    "rounds": 2,
    "transport": "GITHUB_ACTIONS_ARTIFACT_BLACKBOARD_AND_PER_SCOUT_INBOX",
    "message_types": [
      "OBSERVATION_BUNDLE",
      "REQUEST_HELP",
      "CONFLICT_REVIEW",
      "PEER_ROUND_RESPONSE"
    ],
    "full_message_log_preserved": true,
    "peer_round_can_reuse_source_pointer_only_if_recipient_domain_policy_allows": true
  },
  "coordination": {
    "identical_query_policy": "ONE_LEAD_PLUS_DISTINCT_WITNESSES",
    "lead_selection": "DETERMINISTIC_SCOUT_ID_ORDER",
    "witnesses_are_not_removed": true,
    "cross_track_handoff_enabled": true
  },
  "track_routes": {
    "P0_A_HA10_POSITIVE_CONTROL": [
      "P0_A_HA10_POSITIVE_CONTROL",
      "P1_A_H10S_CALIBRATION_TIMELINE",
      "P1_B_BLIND_ATLANTIC_117_121",
      "VERIFY_SYNTHESIZE"
    ],
    "P0_B_NATIVE_CRUISE_TRACK": [
      "P0_B_NATIVE_CRUISE_TRACK",
      "VERIFY_SYNTHESIZE"
    ],
    "P1_A_H10S_CALIBRATION_TIMELINE": [
      "P1_A_H10S_CALIBRATION_TIMELINE",
      "P0_A_HA10_POSITIVE_CONTROL",
      "VERIFY_SYNTHESIZE"
    ],
    "P1_B_BLIND_ATLANTIC_117_121": [
      "P1_B_BLIND_ATLANTIC_117_121",
      "P0_A_HA10_POSITIVE_CONTROL",
      "VERIFY_SYNTHESIZE"
    ],
    "VERIFY_SYNTHESIZE": ["*"]
  },
  "limits": {
    "facts_per_message": 24,
    "source_urls_per_message": 12,
    "queries_per_request": 8,
    "peer_seed_urls": 8,
    "peer_queries": 8
  },
  "evidence_boundary": {
    "orchestrator_message_is_evidence": false,
    "peer_repetition_is_independent_confirmation": false,
    "deduplicated_fact_cluster_erases_observations": false,
    "model_output_is_evidence": false
  }
}
